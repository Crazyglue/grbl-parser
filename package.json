{
  "name": "grbl-parser",
  "version": "0.1.5",
  "type": "module",
  "description": "Javascript-based gcode parser for grbl",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && tsc -p tsconfig.tests.json && node ./node_modules/vitest/vitest.mjs run",
    "coverage": "tsc -p . && tsc -p tsconfig.tests.json && node ./node_modules/vitest/vitest.mjs run --coverage",
    "demo": "tsc -p . && node demo.ts"
  },
  "author": "Eric Dobroveanu",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Crazyglue/grbl-parser.git"
  }
}
